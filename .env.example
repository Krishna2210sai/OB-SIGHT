# Project-level environment template.
#
# For the frontend, copy `frontend/.env.example` to `frontend/.env.local` if
# you need to point Vite at a different API origin. Leave it empty to use
# same-origin requests through the Vite proxy.
#
# Vite only exposes variables prefixed with VITE_.
VITE_API_BASE=

# The FastAPI backend currently has no required environment variables. It reads
# the local artefacts in models/ and reports/ and binds to the host/port passed
# to uvicorn, for example:
#   uvicorn backend.main:app --host 127.0.0.1 --port 8000
